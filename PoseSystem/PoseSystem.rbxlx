	{ Id = "win", Button = "🏆 Мы выиграем?", Keywords = { "выиграем", "выиграть", "шанс", "оправда", "победим", "получится" }, Case = "strength" },
	{ Id = "appeal", Button = "📄 Апелляция", Keywords = { "апелляц", "обжал", "жалоб", "пересмотр" } },
	{ Id = "innocent", Button = "😤 Я не виноват!", Keywords = { "не виноват", "не я", "ошибка", "подстав", "невинов" } },
	{ Id = "scared", Button = "😰 Мне страшно", Keywords = { "страш", "боюсь", "плохо", "помогите", "пережива" } },
	{ Id = "about", Button = "🧑 О себе", Keywords = { "кто вы", "о себе", "расскажи", "опыт", "давно" } },
	{ Id = "price", Button = "🪙 Цена", Keywords = { "стоит", "цена", "деньги", "заплат", "дорого", "дёшев", "дешев" } },
	{ Id = "joke", Button = "😄 Анекдот", Keywords = { "анекдот", "шутк", "пошути", "смешн", "весел" } },
	{ Id = "rude", Keywords = { "дурак", "тупой", "идиот", "бесполез", "плохой адвокат", "лох", "ненавижу" } },
	{ Id = "thanks", Button = "🙏 Спасибо", Keywords = { "спасибо", "благодар", "спс" } },
	{ Id = "bye", Keywords = { "пока", "до свидан", "до встречи" } },
}

