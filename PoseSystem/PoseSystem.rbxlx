	{ Id = "confess", Button = "🙇 Признаваться?", Keywords = { "призна", "сознат", "честно", "правд" } },
	{ Id = "behave", Button = "🎭 Как вести себя в суде?", Keywords = { "вести", "суде", "судья", "сказать", "последнее слово" } },
