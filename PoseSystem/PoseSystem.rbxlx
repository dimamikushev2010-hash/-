]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX15"><Properties><string name="Name">WeaponConfig</string><ProtectedString name="Source"><![CDATA[-- ModuleScript: ReplicatedStorage > WeaponConfig
-- Оружие, розыск и правосудие.
--   🔫 Оружие: пистолет и винтовка (режимы огня, прицел, отдача, перезарядка), 3D-модели из деталей.
--   ⭐ Розыск: свидетели пугаются, прячутся и звонят в 911; полиция едет туда, где тебя видели, и ищет.
--   ⚖️ Арест: отдел (фото, отпечатки, допрос) → КПЗ → суд → тюрьма; оружие и часть денег конфискуют.
-- Игра с оружием и кровью — это «17+» в Roblox: заполни анкету Maturity & Compliance в настройках игры.

local WeaponConfig = {}

WeaponConfig.Enabled = true
WeaponConfig.Blood = true -- брызги и лужа крови (17+). false — без крови
WeaponConfig.PvP = true -- можно стрелять в других игроков
WeaponConfig.CorpseTime = 40 -- сколько секунд лежит тело жителя
WeaponConfig.StartWeapons = { "Pistol", "Rifle" } -- что есть у нового игрока (потом — покупка в 🛍 Магазине телефона)

---------------------------------------------------------------------
-- Оружие
---------------------------------------------------------------------
-- Modes: Semi — одиночные, Burst — очередь по 3, Auto — автоматический огонь
WeaponConfig.Weapons = {
	Pistol = {
		Name = "Пистолет",
		Icon = "🔫",
		Price = 150,
		Damage = 28,
		HeadMultiplier = 2.2,
		RPM = 380, -- выстрелов в минуту
		Modes = { "Semi" },
		Magazine = 12,
		StartAmmo = 48, -- запас патронов
		AmmoPrice = 10, -- за полный магазин
		ReloadTime = 1.5,
		Range = 220,
		Spread = 1.4, -- разброс в градусах от бедра
		AimSpread = 0.35, -- разброс в прицеле
		Recoil = 2.2, -- подброс камеры в градусах
		AimFov = 52, -- поле зрения в прицеле (меньше — сильнее приближение)
		Scope = false,
		Sound = "PistolShot",
	},
	Rifle = {
		Name = "Винтовка",
		Icon = "🎯",
		Price = 400,
		Damage = 24,
		HeadMultiplier = 2,
		RPM = 650,
		Modes = { "Auto", "Burst", "Semi" },
		BurstCount = 3,
		Magazine = 30,
		StartAmmo = 120,
		AmmoPrice = 20,
		ReloadTime = 2.2,
		Range = 350,
		Spread = 2.6,
		AimSpread = 0.25,
		Recoil = 1.3,
		AimFov = 28,
		Scope = true, -- оптический прицел с сеткой
		Sound = "RifleShot",
	},
}

WeaponConfig.Keys = {
	Reload = Enum.KeyCode.R, -- пока оружие в руках, R — перезарядка (лазеры не включаются)
	Mode = Enum.KeyCode.V, -- сменить режим огня
	Surrender = Enum.KeyCode.H, -- поднять руки / сдаться полиции
}

-- Урон по игрокам от полиции
WeaponConfig.PoliceDamage = 14
WeaponConfig.PoliceFireInterval = NumberRange.new(0.55, 1.1)
WeaponConfig.PoliceAccuracy = 0.55 -- шанс попасть на 20 стадах (дальше — меньше)

---------------------------------------------------------------------
-- ⭐ Розыск
---------------------------------------------------------------------
WeaponConfig.Wanted = {
	-- Уровни преступлений (сколько звёзд даёт звонок в 911)
	Trespass = 1, -- залез в чужой дом
	WeaponSeen = 1, -- ходит с оружием
	Aiming = 2, -- целился в человека
	Shots = 2, -- стрелял
	Injury = 3, -- ранил
	Murder = 3, -- убил — огонь на поражение
	PoliceAttack = 4, -- стрелял в полицию
	PoliceKill = 5, -- убил полицейского
	ManyKills = 5, -- убил 4 и больше
	Vandalism = 1, -- сломал камеру наблюдения на глазах у людей

	-- Сколько полицейских машин едет на каждый уровень звёзд
	Units = { 1, 2, 3, 4, 5 },
	-- С какого уровня полиция стреляет без предупреждения
	ShootOnSight = 3,
	-- Через сколько секунд после звонка выезжает полиция (по звёздам)
	DispatchDelay = { 18, 10, 4, 2, 1 },

	-- Свидетели
	SightRange = 45, -- на каком расстоянии житель замечает оружие
	HearShots = 90, -- на каком расстоянии слышны выстрелы
	CallChance = { WeaponSeen = 0.25, Aiming = 0.65, Shots = 0.5, Murder = 0.9, Trespass = 0.8, Vandalism = 0.6 },
	FleeChance = { WeaponSeen = 0.35, Aiming = 0.85, Shots = 0.9 },
	CallTime = 6, -- столько секунд житель говорит по телефону (если его остановить — звонка не будет)
	KeepDistance = 16, -- на сколько жители отходят от человека с оружием
	TrespassGrace = 6, -- сколько секунд можно стоять в чужом доме, пока не позвонят

	-- Поиск
	ReportNoise = 18, -- свидетель описывает место неточно (± стадов)
	SearchRadius = 45, -- где полиция ищет вокруг последнего места
	PoliceSight = 70, -- как далеко видит полицейский
	EvadeTime = 45, -- сколько секунд не видеть игрока, чтобы снять звёзды (+ по 15 за звезду)
	EvadePerStar = 15,
	ArrestDistance = 6, -- с какого расстояния надевают наручники
	SurrenderTime = 2.5, -- «Руки вверх!» — сколько секунд стоять спокойно
	DownedHealth = 12, -- при таком здоровье игрока в розыске не убивают, а задерживают
}

---------------------------------------------------------------------
-- ⚖️ Правосудие
---------------------------------------------------------------------
WeaponConfig.Justice = {
	HoldingTime = 25, -- сколько секунд в КПЗ до суда (если запущен CourtServer — CourtConfig.HoldingTime)
	Sentence = { Base = 30, PerStar = 30, PerKill = 20, Max = 300 }, -- срок в секундах
	ConfessDiscount = 0.2, -- признался на допросе — срок меньше на 20%
	LieExtra = 0.15, -- соврал — больше на 15%
	FineBase = 50, -- штраф: база + доля монет
	FineFraction = 0.25,
	ConfiscateWeapons = true,
	WastedFine = 0.15, -- погиб в розыске — теряешь эту долю монет и оружие
	PrisonRadius = 30, -- уйти дальше от тюрьмы во время срока нельзя (вернёт обратно)

	JudgeName = "Судья",
	JudgeShirt = Color3.fromRGB(20, 20, 24),
	Questions = {
		{ Text = "Где вы были в момент происшествия?", Answers = { { "Это был я. Признаю.", "confess" }, { "Я был дома, спал.", "lie" }, { "Без адвоката говорить не буду.", "silent" } } },
		{ Text = "Откуда у вас оружие?", Answers = { { "Купил в магазине.", "confess" }, { "Нашёл на улице.", "lie" }, { "...", "silent" } } },
		{ Text = "Вы понимаете, что пострадали люди?", Answers = { { "Да. Мне очень жаль.", "confess" }, { "Никто не пострадал!", "lie" }, { "Я ничего не скажу.", "silent" } } },
	},
	Verdicts = {
		"Суд признаёт подсудимого виновным.",
		"Учитывая обстоятельства дела, суд постановил:",
	},
}

-- Фразы
WeaponConfig.Lines = {
	SeeWeapon = { "У него пистолет!", "Осторожно, оружие!", "Ой… уберите это!", "Он вооружён!" },
	Aimed = { "Не стреляйте!", "А-а-а! Помогите!", "Пожалуйста, не надо!", "Он целится в меня!" },
	Shots = { "Стреляют!", "Ложись!", "Бегите!", "Помогите!" },
	Body = { "Он убил человека!", "О боже… Вызовите полицию!", "Скорую! Кто-нибудь!" },
	Trespass = { "Эй! Кто вы такой?!", "Вон из моего дома!", "Я вызываю полицию!" },
	Vandalism = { "Эй! Вы что делаете?!", "Он сломал камеру!", "Хулиган! Я звоню в полицию!" },
	Call = { "Алло, 911? Тут человек с оружием!", "Полиция? Здесь стрельба!", "Алло! Срочно приезжайте!", "Кто-то залез ко мне в дом!" },
	PoliceArrive = { "Полиция! Всем оставаться на местах!", "Ищем подозреваемого.", "Проверим район." },
	PoliceSee = { "Вот он! Стоять!", "Полиция! Руки вверх!", "Подозреваемый замечен!" },
	PoliceShoot = { "Бросай оружие!", "Огонь!", "Открываем огонь!" },
	PoliceArrest = { "Вы арестованы. Руки за спину.", "Вы имеете право хранить молчание." },
	PoliceLost = { "Потеряли его.", "Ушёл. Прочёсываем район.", "Отбой, никого." },
}

return WeaponConfig
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX16"><Properties><string name="Name">CourtConfig</string><ProtectedString name="Source"><![CDATA[-- ModuleScript: ReplicatedStorage > CourtConfig
-- Адвокат, залог, настоящий суд и камеры наблюдения (дополняет WeaponConfig.Justice).
--   🔒 КПЗ: один звонок — адвокату или другу-игроку; залог — сразу в суд без ожидания.
--   💼 Адвокаты: государственный (бесплатно) и платные; с каждым можно поговорить (кнопки или свой текст).
--   ⚖️ Суд: обвинение, свидетели (те, кто звонил в 911), записи камер, защита, последнее слово, приговор, апелляция.
--   📹 Камеры снимают преступления; сломал камеру до суда — запись пропала.
-- В текстах можно писать подстановки: {player} {lawyer} {sentence} {witnesses} {cameras} {bail} {price} {strength} {crimes}

local CourtConfig = {}

CourtConfig.Enabled = true

---------------------------------------------------------------------
-- 🔒 КПЗ и залог
---------------------------------------------------------------------
CourtConfig.HoldingTime = 75 -- сколько секунд ждать суда в КПЗ (вместо WeaponConfig.Justice.HoldingTime)
CourtConfig.Bail = {
	Base = 40, -- залог: база + за звезду + за убийство
	PerStar = 35,
	PerKill = 60,
	Max = 600,
	NoBailForPoliceKill = true, -- за убийство полицейского залог не положен
	Refund = false, -- залог не возвращается (оплата за то, чтобы не ждать в КПЗ)
}
CourtConfig.CallTimeout = 30 -- сколько секунд друг может ответить на звонок
CourtConfig.FriendReward = 15 -- монеты другу, который пришёл защищать в суд

---------------------------------------------------------------------
-- 💼 Адвокаты (первый — государственный, он есть у всех бесплатно)
---------------------------------------------------------------------
-- Discount — на сколько меньше срок; DoubtWitness / DoubtCamera — шанс оспорить показания свидетеля / запись камеры;
-- Appeal — шанс выиграть апелляцию.
CourtConfig.Lawyers = {
	{
		Id = "Public",
		Name = "Пётр Иванович",
		Title = "Государственный адвокат",
		Icon = "🧑‍💼",
		Price = 0,
		Rating = 1,
		Discount = 0.05,
		DoubtWitness = 0.1,
		DoubtCamera = 0,
		Appeal = 0.15,
		Perks = "Бесплатно. Устал, но старается",
		Style = "уставший государственный защитник, сам над собой иронизирует, старается, но часто сдаётся",
		Shirt = Color3.fromRGB(110, 100, 90),
		Pants = Color3.fromRGB(60, 58, 55),
	},
	{
		Id = "Cheap",
		Name = "Гоша «Договоримся»",
		Title = "Недорогой адвокат",
		Icon = "🕴️",
		Price = 60,
		Rating = 2,
		Discount = 0.15,
		DoubtWitness = 0.25,
		DoubtCamera = 0.1,
		Appeal = 0.3,
		Perks = "Срок −15%. Иногда путает свидетелей",
		Style = "болтливый уличный адвокат, говорит просто и с жаргоном, давит на жалость, любит торговаться",
		Shirt = Color3.fromRGB(150, 60, 60),
		Pants = Color3.fromRGB(40, 40, 45),
	},
	{
		Id = "Pro",
		Name = "Анна Сергеевна Крылова",
		Title = "Опытный адвокат",
		Icon = "👩‍⚖️",
		Price = 180,
		Rating = 4,
		Discount = 0.3,
		DoubtWitness = 0.45,
		DoubtCamera = 0.3,
		Appeal = 0.5,
		Perks = "Срок −30%. Оспаривает свидетелей и записи камер",
		Style = "спокойная и точная, цепляется к деталям и нестыковкам, вежлива, но жёсткая в споре",
		Shirt = Color3.fromRGB(40, 50, 80),
		Pants = Color3.fromRGB(30, 34, 50),
	},
	{
		Id = "Star",
		Name = "Марк Золотов",
		Title = "Звёздный адвокат",
		Icon = "💎",
		Price = 450,
		Rating = 5,
		Discount = 0.45,
		DoubtWitness = 0.65,
		DoubtCamera = 0.5,
		Appeal = 0.75,
		Perks = "Срок −45%. Почти не проигрывает, апелляции — его конёк",
		Style = "самоуверенная звезда, театральные речи, остроумные выпады, давит на прокурора авторитетом",
		Shirt = Color3.fromRGB(25, 25, 28),
		Pants = Color3.fromRGB(25, 25, 28),
	},
}

---------------------------------------------------------------------
-- ⚖️ Суд: доказательства и срок
---------------------------------------------------------------------
CourtConfig.Evidence = {
	Witness = 1, -- очки за свидетеля, который звонил в 911
	DoubtedWitness = 0.3, -- свидетель, которого оспорил адвокат
	CallRecord = 0.6, -- свидетель не дожил до суда — слушают запись его звонка
	Camera = 1.5, -- запись камеры
	Police = 2, -- полиция видела сама
	Confession = 0.7, -- за каждое признание на допросе
	AcquitBelow = 1, -- меньше очков — оправдан за недостатком доказательств
	MaxWitnesses = 3, -- сколько свидетелей выступает (остальных упоминают)
	MaxCameras = 3,
}
-- Сила доказательств меняет срок: множитель = Base + PerPoint × очки (не меньше Min и не больше Max)
CourtConfig.Strength = { Base = 0.55, PerPoint = 0.12, Min = 0.6, Max = 1.25 }
CourtConfig.Surrender = 0.15 -- не сопротивлялся при аресте — срок меньше на 15%
CourtConfig.Resist = 0.2 -- сопротивлялся (убегал от полиции, стрелял, задержан раненым) — больше на 20%
CourtConfig.MinSentence = 20 -- секунд, меньше не бывает (если не оправдан)

-- Последнее слово подсудимого
CourtConfig.LastWord = {
	{ Text = "Я раскаиваюсь. Простите меня.", Effect = -0.1, Reply = "Суд учтёт ваше раскаяние." },
	{ Text = "Мне нечего сказать.", Effect = 0, Reply = "Ваше право." },
	{ Text = "Я невиновен! Это всё подстроено!", Effect = 0.03, Reply = "Суд это уже слышал." },
	{ Text = "Я ни о чём не жалею!", Effect = 0.15, Reply = "Дерзость в зале суда вам не поможет." },
}
CourtConfig.LastWordTime = 12

-- Речь друга-защитника (выбирает друг)
CourtConfig.FriendSpeeches = {
	{ Text = "Я знаю {player} давно — это хороший человек, просто оступился!", Effect = -0.1 },
	{ Text = "{player} всегда помогал соседям. Дайте ему шанс!", Effect = -0.08 },
	{ Text = "Ваша честь, я ручаюсь за {player}. Такого больше не повторится.", Effect = -0.12 },
	{ Text = "Ну… обычно {player} не такой.", Effect = -0.03 },
}
CourtConfig.FriendSpeechTime = 15

-- Апелляция
CourtConfig.Appeal = {
	Price = 40, -- стоимость жалобы
	Cut = 0.4, -- выиграл — срок меньше на 40%, штраф вдвое меньше
	Time = 12, -- сколько секунд думать
}

-- Речь адвоката в суде (по силе улик: Weak / Medium / Strong)
CourtConfig.DefenseSpeech = {
	Public = {
		Weak = { "Ваша честь, доказательств нет. Отпустите моего подзащитного, и я пойду на следующее дело." },
		Medium = { "Ваша честь, улики спорные. Прошу о снисхождении." },
		Strong = { "Ваша честь… прошу учесть, что подсудимый — человек. Это всё." },
	},
	Cheap = {
		Weak = { "Ваша честь, да тут дела-то нет! Всё на соплях!" },
		Medium = { "Ваша честь, ну со всеми бывает! Дайте поменьше, а?" },
		Strong = { "Ваша честь, мой клиент всё понял. Ну правда понял. Скиньте срок!" },
	},
	Pro = {
		Weak = { "Ваша честь, обвинение не представило ни одного надёжного доказательства. Прошу оправдать." },
		Medium = { "Показания противоречивы, записи неубедительны. Прошу минимальное наказание." },
		Strong = { "Мой подзащитный сотрудничал со следствием. Прошу учесть все смягчающие обстоятельства." },
	},
	Star = {
		Weak = { "Ваша честь, это не дело, а сказка. И у сказки будет счастливый конец — оправдание." },
		Medium = { "Дамы и господа! Сомнение толкуется в пользу обвиняемого. А сомнений тут — целый город." },
		Strong = { "Ваша честь, каждый заслуживает второго шанса. Мой клиент заслуживает его особенно. Прошу самый мягкий приговор." },
	},
}

CourtConfig.ProsecutorName = "Прокурор"
CourtConfig.ProsecutorShirt = Color3.fromRGB(30, 40, 90)
CourtConfig.WitnessShirt = Color3.fromRGB(120, 140, 120)

-- Необязательные метки в Workspace > JusticeSystem > Court (без них реплики идут только субтитрами):
--   Prosecutor — где стоит прокурор, Defense — где стоит адвокат, Witness — трибуна свидетеля,
--   Defender — куда встаёт друг-защитник (иначе рядом с Dock).
-- И в TrafficSystem > PoliceStation: Visit — где адвокат стоит у КПЗ, пока вы говорите.

---------------------------------------------------------------------
-- 📹 Камеры наблюдения
---------------------------------------------------------------------
CourtConfig.Cameras = {
	Enabled = true,
	Range = 60, -- как далеко видит камера
	Fov = 80, -- угол обзора в градусах (купольная камера — 360)
	Throttle = 15, -- одна и та же камера записывает одно и то же раз в столько секунд
	RecordLife = 900, -- записи старше стольких секунд в суд уже не идут
	RepairTime = 180, -- через сколько секунд сломанную камеру чинят (старые записи не вернутся)
	BreakHold = 1.2, -- сколько держать E, чтобы сломать
	BreakDistance = 11,
	BulletsToBreak = 1, -- сколько попаданий нужно
	-- Нет папки JusticeSystem > Cameras — камеры ставятся сами у мест вызова полиции (PoliceCalls) и мест города (Places)
	AutoPlace = true,
	AutoRange = 45,
	AutoMax = 16,
	NotifyPlayer = true, -- показать игроку «📹 Тебя сняла камера»
}

---------------------------------------------------------------------
-- Тексты суда
---------------------------------------------------------------------
CourtConfig.Lines = {
	JudgeOpen = { "Встать, суд идёт! Слушается дело № {number}.", "Судебное заседание объявляю открытым. Дело № {number}." },
	ProsecutorCharge = { "Подсудимый {player} обвиняется: {crimes}.", "Ваша честь, обвинение такое: {crimes}." },
	ProsecutorWitness = { "Вызывается свидетель {name}.", "Обвинение вызывает свидетеля {name}." },
	WitnessSay = {
		"Это был он! Я видел своими глазами: {why}. Я сразу позвонил в 911.",
		"Да, я его узнаю. {Why}. Мне до сих пор страшно.",
		"Я был рядом. {Why}. Я взял телефон и вызвал полицию.",
		"Вот этот человек! {Why}. Я никогда этого не забуду.",
	},
	LawyerDoubtWitness = { "Свидетель, вы же стояли далеко? И было темно?", "Вы точно уверены? Вы же были напуганы.", "У вас есть очки? Вы в них были?" },
	WitnessUnsure = { "Ну… может, и не он…", "Я… я уже не уверен.", "Было быстро, я плохо разглядел." },
	WitnessDead = { "Свидетель {name} не может явиться в суд. Прошу включить запись его звонка в 911." },
	ProsecutorCamera = { "Прошу показать запись с камеры «{cam}».", "У обвинения есть видео с камеры «{cam}»." },
	CameraShow = "На записи: {why}.",
	LawyerDoubtCamera = { "Запись нечёткая, лица не разглядеть!", "Это может быть кто угодно, Ваша честь!" },
	JudgeRejectCamera = { "Суд не принимает эту запись.", "Запись нечёткая. Не принимается." },
	CameraLost = { "Камера «{cam}» была сломана — запись не сохранилась.", "К сожалению, запись с камеры «{cam}» уничтожена." },
	NoWitnesses = { "Свидетелей по делу нет.", "Никто из жителей полицию не вызывал." },
	PoliceSay = { "Я лично видел подсудимого на месте преступления.", "Подсудимый был задержан нами на месте. Мы всё видели." },
	ConfessionSay = "На допросе подсудимый признал вину ({n}).",
	Surrendered = "При задержании подсудимый не сопротивлялся. Суд это учтёт.",
	Resisted = "При задержании подсудимый оказал сопротивление.",
	JudgeLastWord = "Подсудимый, ваше последнее слово.",
	JudgeFriend = "Слово предоставляется защитнику — {name}.",
	JudgeGuilty = { "Изучив доказательства, суд признаёт подсудимого виновным.", "Суд удаляется… Суд вернулся. Подсудимый виновен." },
	JudgeSentence = "Приговор: {sentence} лишения свободы и штраф {fine} монет.",
	JudgeAcquit = { "Доказательств недостаточно. Подсудимый оправдан и освобождается в зале суда!", "Обвинение ничего не доказало. Вы свободны." },
	Confiscate = "Оружие конфисковать.",
	JudgeAppealAsk = "Приговор можно обжаловать.",
	AppealWin = { "Апелляционный суд смягчил приговор: {sentence} и штраф {fine} монет.", "Жалоба удовлетворена! Новый срок — {sentence}." },
	AppealLose = { "Апелляционный суд оставил приговор в силе.", "Жалоба отклонена." },
}

---------------------------------------------------------------------
-- 💬 Разговор с адвокатом
---------------------------------------------------------------------
-- Темы: кнопка + слова, по которым тема узнаётся, если игрок пишет сам.
-- Case — от чего зависит ответ: witnesses / cameras (None/Some), strength (Weak/Medium/Strong), bail (Yes/No/Paid)
CourtConfig.Topics = {
	{ Id = "hello", Button = "👋 Здравствуйте", Keywords = { "привет", "здравств", "добрый", "здаров", "хай", "салам" } },
