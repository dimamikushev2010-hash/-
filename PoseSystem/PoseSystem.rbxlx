btn(titleBar, "✕", { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -8, 0, 4), Size = UDim2.fromOffset(28, 28), AutomaticSize = Enum.AutomaticSize.None, BackgroundTransparency = 1 }, function()
	win.Visible = false
